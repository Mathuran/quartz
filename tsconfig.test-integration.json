{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2020",
    "lib": ["ES2020"],
    "outDir": "dist/test/integration",
    "rootDir": "test/integration",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "resolveJsonModule": true
  },
  "include": ["test/integration/**/*.ts"],
  "exclude": ["test/integration/fixtures"]
}
