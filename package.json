{
  "name": "quartz-markdown-editor",
  "displayName": "Quartz — Pretty Markdown Editor",
  "description": "A Notion-style block-based WYSIWYG markdown editor for VS Code",
  "version": "0.1.4",
  "publisher": "quartz",
  "license": "MIT",
  "icon": "images/croppedQuartz.png",
  "galleryBanner": {
    "color": "#1a1a2e",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Mathuran/quartz"
  },
  "homepage": "https://github.com/Mathuran/quartz#readme",
  "bugs": {
    "url": "https://github.com/Mathuran/quartz/issues"
  },
  "keywords": [
    "markdown",
    "editor",
    "wysiwyg",
    "notion",
    "block editor",
    "tiptap"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "quartz.outline",
          "name": "Document Outline",
          "when": "activeCustomEditorId == quartz.markdownEditor"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "quartz.markdownEditor",
        "displayName": "Quartz Markdown Editor",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "quartz.openWithQuartz",
        "title": "Open with Quartz Editor",
        "category": "Quartz"
      },
      {
        "command": "quartz.openWithTextEditor",
        "title": "Open with Text Editor",
        "category": "Quartz"
      },
      {
        "command": "quartz.toggleEditor",
        "title": "Toggle Editor Mode",
        "category": "Quartz",
        "icon": "$(symbol-keyword)"
      },
      {
        "command": "quartz.scrollToHeading",
        "title": "Scroll to Heading",
        "category": "Quartz"
      },
      {
        "command": "quartz.refreshOutline",
        "title": "Refresh Outline",
        "category": "Quartz",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "quartz.toggleEditor",
          "when": "resourceExtname == .md",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "quartz.refreshOutline",
          "when": "view == quartz.outline",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "quartz.openWithQuartz",
          "when": "resourceExtname == .md",
          "group": "navigation"
        },
        {
          "command": "quartz.openWithTextEditor",
          "when": "resourceExtname == .md",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Quartz Markdown Editor",
      "properties": {
        "quartz.editor.defaultForMarkdown": {
          "type": "boolean",
          "default": false,
          "description": "Set Quartz as the default editor for .md files"
        },
        "quartz.editor.theme": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "light",
            "dark"
          ],
          "description": "Editor theme"
        },
        "quartz.editor.fontFamily": {
          "type": "string",
          "default": "inherit",
          "description": "Font family for the editor (inherit uses VS Code's font)"
        },
        "quartz.editor.fontSize": {
          "type": "number",
          "default": 16,
          "description": "Editor font size in pixels"
        },
        "quartz.editor.pageLayout": {
          "type": "boolean",
          "default": true,
          "description": "Enable letter-sized page view"
        },
        "quartz.editor.pageMargin": {
          "type": "number",
          "default": 72,
          "description": "Inner page margin in pixels"
        },
        "quartz.editor.imageDir": {
          "type": "string",
          "default": "./assets",
          "description": "Relative path for pasted images"
        },
        "quartz.editor.preserveFormatting": {
          "type": "boolean",
          "default": true,
          "description": "Maintain original markdown style on round-trip"
        },
        "quartz.editor.showBlockHandles": {
          "type": "boolean",
          "default": true,
          "description": "Show drag handles on block hover"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "build:watch": "node esbuild.js --watch",
    "build:webview": "node esbuild.js --webview-only",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "lint:fix": "eslint --fix src/",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "test:integration": "tsc -p tsconfig.test-integration.json && vscode-test",
    "test:e2e": "npx playwright test --max-failures=1 --retries=0",
    "serve:e2e": "npm run build:webview && npx tsx test/e2e/server.ts",
    "bench": "vitest bench --run",
    "test:all": "npm test && npm run test:integration && npm run test:e2e",
    "package": "vsce package",
    "setup:env": "gh secret list --env prod && echo '\n# Create .env file with VSCE_PAT from GitHub secrets (prod environment)' && echo 'VSCE_PAT=' > .env && echo 'Created .env - add your VSCE_PAT value'",
    "publish:local": "source .env && npm run build && vsce publish -p $VSCE_PAT",
    "publish:ci": "npm run build && vsce publish -p $VSCE_PAT",
    "doctor": "react-doctor"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.24.0",
    "eslint": "^10.0.1",
    "eslint-plugin-security": "^4.0.0",
    "prettier": "^3.8.1",
    "react-doctor": "^0.0.29",
    "typescript": "^5.3.3",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@tiptap/core": "^2.11.0",
    "@tiptap/extension-blockquote": "^2.11.0",
    "@tiptap/extension-bold": "^2.11.0",
    "@tiptap/extension-bullet-list": "^2.11.0",
    "@tiptap/extension-code": "^2.11.0",
    "@tiptap/extension-code-block-lowlight": "^2.11.0",
    "@tiptap/extension-document": "^2.11.0",
    "@tiptap/extension-dropcursor": "^2.11.0",
    "@tiptap/extension-gapcursor": "^2.11.0",
    "@tiptap/extension-hard-break": "^2.11.0",
    "@tiptap/extension-heading": "^2.11.0",
    "@tiptap/extension-highlight": "^2.11.0",
    "@tiptap/extension-history": "^2.11.0",
    "@tiptap/extension-horizontal-rule": "^2.11.0",
    "@tiptap/extension-image": "^2.11.0",
    "@tiptap/extension-italic": "^2.11.0",
    "@tiptap/extension-link": "^2.11.0",
    "@tiptap/extension-list-item": "^2.11.0",
    "@tiptap/extension-ordered-list": "^2.11.0",
    "@tiptap/extension-paragraph": "^2.11.0",
    "@tiptap/extension-placeholder": "^2.11.0",
    "@tiptap/extension-strike": "^2.11.0",
    "@tiptap/extension-table": "^2.11.0",
    "@tiptap/extension-table-cell": "^2.11.0",
    "@tiptap/extension-table-header": "^2.11.0",
    "@tiptap/extension-table-row": "^2.11.0",
    "@tiptap/extension-task-item": "^2.11.0",
    "@tiptap/extension-task-list": "^2.11.0",
    "@tiptap/extension-text": "^2.11.0",
    "@tiptap/pm": "^2.11.0",
    "@tiptap/react": "^2.11.0",
    "@tiptap/suggestion": "^2.11.0",
    "highlight.js": "^11.9.0",
    "lowlight": "^3.1.0",
    "markdown-it": "^14.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
