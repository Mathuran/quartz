{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    "src/extension.ts",
    "src/webview/index.tsx",
    "src/webview/lowlightLanguages.ts",
    "scripts/*.ts",
    "website/**/*.{js,ts}",
    ".vscode-test.mjs"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "scripts/**/*.ts",
    "website/**/*.{js,ts}"
  ],
  "ignore": [
    "test/**"
  ]
}
